{
  "name": "04_npm_scripts",
  "version": "1.0.0",
  "private": true,
  "description": "npm scripts for dbmate migrations and SQLite seeding",
  "scripts": {
    "migrate": "dbmate up",
    "migrate:down": "dbmate down",
    "migrate:status": "dbmate status",
    "migrate:new": "dbmate new",
    "db:seed": "dotenv -- sh -c 'sqlite3 \"$SQLITE_DB_PATH\" < db/seed.sql'",
    "db:reset": "dbmate drop && dbmate up && npm run db:seed"
  },
  "devDependencies": {
    "dbmate": "^2.33.0",
    "dotenv-cli": "^8.0.0"
  }
}
